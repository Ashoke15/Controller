<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <!-- BT status -->
        <LinearLayout
            android:id="@+id/btStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill_off"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/dotStatus"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_pill_off"/>

            <TextView
                android:id="@+id/tvBtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tap to connect"
                android:textColor="@color/accent_red"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Headlight -->
        <ImageButton
            android:id="@+id/btnHeadlight"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_toggle_button"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Headlight"/>

        <!-- Backlight -->
        <ImageButton
            android:id="@+id/btnBacklight"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_toggle_button"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Backlight"/>

        <!-- Horn -->
        <ImageButton
            android:id="@+id/btnHorn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_toggle_button"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:contentDescription="Horn"/>

        <!-- Hazard / Extra -->
        <ImageButton
            android:id="@+id/btnHazard"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_toggle_button"
            android:src="@android:drawable/ic_dialog_alert"
            android:contentDescription="Hazard"/>

        <!-- Speed slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Speed"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"/>

        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progress="50"/>

        <TextView
            android:id="@+id/tvSpeedValue"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:gravity="center"/>

        <!-- Settings -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_toggle_button"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="Settings"/>

        <!-- Emergency stop -->
        <Button
            android:id="@+id/btnStopAll"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="STOP"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accent_red"/>

    </LinearLayout>

    <!-- MAIN CONTROL AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- LEFT: UP / DOWN -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnUp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dpad_button"
                android:src="@android:drawable/arrow_up_float"
                android:scaleType="fitCenter"
                android:padding="30dp"
                android:contentDescription="Forward"/>

            <ImageButton
                android:id="@+id/btnDown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dpad_button"
                android:src="@android:drawable/arrow_down_float"
                android:scaleType="fitCenter"
                android:padding="30dp"
                android:contentDescription="Back"/>
        </LinearLayout>

        <!-- CENTER: spacer / could hold speedometer later -->
        <View
            android:layout_width="24dp"
            android:layout_height="match_parent"/>

        <!-- RIGHT: LEFT / RIGHT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dpad_button"
                android:src="@android:drawable/arrow_up_float"
                android:rotation="270"
                android:scaleType="fitCenter"
                android:padding="30dp"
                android:contentDescription="Left"/>

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dpad_button"
                android:src="@android:drawable/arrow_up_float"
                android:rotation="90"
                android:scaleType="fitCenter"
                android:padding="30dp"
                android:contentDescription="Right"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>